{
    // 家族名由 option input「家族名称」经 pipeline_override 插值(默认 雷霆万钧)
    // 注意：基础文件里的 {占位符} 框架不会替换(只有 option 的 pipeline_override 才是插值模板)，
    //      所以不配置 option 直接跑时这里永远不匹配 → 会一路右箭头遍历后安全停止
    //
    // 换家族循环：每轮按序识别同一份 next 候选，首个命中即执行
    //   读取当前家族 → 顶部名字 == 目标 → 命中 → 去 03 读免费次数、开弹窗刷新
    //   判断到头     → 右箭头已灰(已在最右家族) → 命中 → 家族未找到停止
    //   点击右箭头   → 右箭头还是金色(右边还有家族) → 命中 → 点一下并回到本轮开头
    // 协议：候选自身 miss 不会触发该候选的 on_error；只有「当前节点的 next 全部 miss 并超时」
    //       才走当前节点的 on_error —— 所以换家族判断只用 next 候选表达，不需要 on_error 兜底
    "家族天赋_读取当前家族": {
        "timeout": 2000,
        "recognition": "OCR",
        "expected": [
            "{家族名称}"
        ],
        "roi": [
            360,
            0,
            310,
            60
        ],
        "only_rec": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_读取免费次数"
        ]
    },
    // 右箭头有两种状态(实测)：金色=可点(右边还有家族)、银白灰=到头(已在最右家族)
    // only_rec=true 只识别不动作，纯判断节点
    // 命中   = 灰箭头 → 名字不是目标且已到列表尽头 → 家族未找到停止
    // 未命中 = 还没到头 → 同一个 next 列表里的「点击右箭头」接手继续切家族
    // 本节点不需要 on_error：它的 next 只有「家族未找到停止」(DirectHit 恒命中)，不存在全部 miss 的可能
    "家族天赋_判断到头": {
        "timeout": 2000,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/右箭头_灰.png"
        ],
        // 实测金箭头模板对灰箭头 score 0.83，默认阈值 0.7 会误判，0.9 才能分开灰/金
        "threshold": 0.9,
        "roi": [
            1185,
            300,
            85,
            130
        ],
        "only_rec": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_家族未找到停止"
        ]
    },
    // 只认金色箭头：灰箭头不可点，匹配不到金色就不会在尽头空点
    // max_hit 51 = 防呆兜底(家族共 51 个)：连续点 51 次仍没读到目标名字就认定找不到
    // 回环 = 本节点 next 的三候选：先重读名字，再判到头，最后才自己再点一次箭头
    // on_error 只在「next 全部 miss 并超时」时触发，即 max_hit 用尽且名字仍不匹配 → 安全停止
    "家族天赋_点击右箭头": {
        "timeout": 2000,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/右箭头_金.png"
        ],
        // 同上：0.9 隔离灰箭头干扰(实测 0.83)
        "threshold": 0.9,
        "roi": [
            1185,
            300,
            85,
            130
        ],
        "action": "Click",
        "max_hit": 51,
        "next": [
            "家族天赋_读取当前家族",
            "家族天赋_判断到头",
            "家族天赋_点击右箭头"
        ],
        "on_error": [
            "家族天赋_家族未找到停止"
        ]
    },
    // 未解锁家族的实测特征：顶部无名字、无「查看天赋」按钮、右箭头可金可灰，底部信息行正常
    // → 未解锁家族既读不到名字也点不开天赋弹窗，无法被选中刷天赋
    "家族天赋_家族未找到停止": {
        "action": "DoNothing",
        "focus": "已遍历到列表尽头(右箭头已灰)，未找到目标家族。注意：未解锁的家族顶部无名字且无查看天赋按钮，无法被选中刷新；请确认输入的家族名称正确且该家族已解锁。已安全停止，未消耗任何资源",
        "next": [
            "[JumpBack]返回主界面"
        ]
    }
}
