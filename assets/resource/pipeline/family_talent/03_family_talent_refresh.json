{
    // 「今日免费刷新次数：N」只在家族页(天赋弹窗关闭时)可见，所以次数判断发生在弹窗打开之前
    // 本文件职责：次数判断 → 开天赋弹窗 → 防钻石守卫 → 免费刷新/广告卡刷新 → 评估属性 → 达标保存
    "家族天赋_读取免费次数": {
        "timeout": 2000,
        "recognition": "OCR",
        "expected": [
            "今日免费刷新次数"
        ],
        "roi": [
            640,
            515,
            380,
            60
        ],
        "only_rec": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_免费次数判断"
        ],
        "on_error": [
            "家族天赋_免费耗尽收尾"
        ]
    },
    // CustomRecognition(agent/family_talent.py)：内部自己 OCR「今日免费刷新次数：N」
    //   param 免费次数文本框  = 该行文字所在的 ROI
    //   param 免广告卡已启用  = option「使用免广告卡次数」是否配置(true 时 0 次也继续走广告卡链)
    //   命中   = N>0，或 N=0 但免广告卡已启用(还能靠广告换刷新)
    //   未命中 = N=0 且没开免广告卡 → 没有可刷的手段
    // 未命中的分支由上一节点(家族天赋_读取免费次数)的 on_error 兜底(超时 2s)：
    // 协议里候选自身 miss 不触发该候选的 on_error，只有上一节点的 next 全 miss 超时才走上一节点的 on_error
    "家族天赋_免费次数判断": {
        "action": "DoNothing",
        "recognition": "Custom",
        "custom_recognition": "FamilyTalentCountCheck",
        "custom_recognition_param": {
            "免费次数文本框": [
                640,
                515,
                380,
                60
            ],
            "免广告卡已启用": false
        },
        "next": [
            "家族天赋_打开天赋弹窗2"
        ]
    },
    // 免费次数 0 且免广告卡未启用(或没开卡链) → 无资源可刷，但右栏可能已有达标的候选
    // (上次刷新结果会留在弹窗里) → 仍要开弹窗评估：达标就保存，不达标才真正无事可做
    // 评估不达标后走 未达标收尾(经 防钻石守卫 miss 路径)，不会再点任何刷新按钮
    "家族天赋_免费耗尽收尾": {
        "action": "DoNothing",
        "focus": "免费次数与免广告卡均已用完：先检查弹窗里已有候选是否达标，达标则保存，不达标则结束(不消耗钻石)",
        "next": [
            "家族天赋_打开天赋弹窗2"
        ]
    },
    // 家族页右上「查看天赋」按钮(实测：未解锁的家族没有这个按钮)
    // next 第二候选是自己：点一下没反应(加载/动画)就再点一次
    // max_hit 5：点 5 次还进不去说明按钮异常，靠 on_error 收尾，防识别/点击失效时自回环死循环
    // on_error：按钮根本找不到 = 异常/家族未解锁 → 不收尾乱点，直接免费耗尽收尾安全停止
    "家族天赋_打开天赋弹窗2": {
        "max_hit": 5,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/查看天赋.png"
        ],
        "threshold": 0.9,
        "roi": [
            680,
            45,
            230,
            100
        ],
        "action": "Click",
        "next": [
            "家族天赋_弹窗确认2",
            "家族天赋_打开天赋弹窗2"
        ],
        "on_error": [
            "家族天赋_免费耗尽收尾"
        ]
    },
    // 弹窗已打开：用标题「家族天赋」确认(only_rec 只识别不点击)
    // 确认不了(超时)说明没进弹窗，走安全收尾，不在家族页/别的界面上乱点
    // next 第一候选「锁槽判断」= 锁槽阶段入口(DirectHit 恒命中)：先按 option「家族天赋刷新槽位」
    //   把不刷新的槽锁上，再评估右栏已有候选(上次刷新结果会留在弹窗里)，达标就直接保存，一次刷新都不用花；
    //   不达标才进入刷新循环(锁槽判断 next 尾部的「刷新计数」)
    "家族天赋_弹窗确认2": {
        "recognition": "OCR",
        "expected": [
            "家族天赋"
        ],
        "roi": [
            480,
            30,
            330,
            80
        ],
        "only_rec": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_锁槽判断",
            "家族天赋_刷新计数"
        ],
        "on_error": [
            "家族天赋_未达标收尾"
        ]
    },
    // ===== 锁槽阶段（由 option「家族天赋刷新槽位」控制）=====
    // 勾选的槽位=要刷新=不锁；未勾选的槽位=要保住=刷新前先锁上(游戏里被锁定的属性不会被刷新更改)
    // 基础文件里 锁槽1执行/锁槽2执行 都是 enabled:true(默认锁)；checkbox 勾了「框1」→ 该 case 的
    //   pipeline_override 把 锁槽1执行 置 enabled:false(不锁)。勾=覆盖生效=不锁，未勾=基础值=锁。
    // 一次只能锁一个：每锁完一个回到本节点重新判断(锁图标变绿后对应模板不再命中)，都不需要锁时
    //   依次落到 钻石解锁守卫 miss → 双锁防呆 miss → 评估属性，行为与没有锁槽阶段时一致
    // 钻石解锁守卫 在 锁槽执行 之后：先把用户勾选保护(锁槽)做完，再检测未解锁槽的钻石按钮决定是否安全停手
    "家族天赋_锁槽判断": {
        "timeout": 5000,
        "action": "DoNothing",
        "next": [
            "家族天赋_锁槽1执行",
            "家族天赋_锁槽2执行",
            "家族天赋_钻石解锁守卫",
            "家族天赋_双锁防呆",
            "家族天赋_评估属性",
            "家族天赋_刷新计数"
        ],
        "on_error": [
            "家族天赋_未达标收尾"
        ]
    },
    // 槽1 锁图标(灰开锁)在左栏槽1位置；命中=槽1当前未锁 → 点它弹锁定确认框
    // max_hit 2：最多点 2 次(一次重试)，防模板误命中/确认框没弹出时来回点
    // next 第二候选回「锁槽判断」：点完 2.5s 内没弹确认框也回判断，继续处理另一个槽或去评估
    // 勾了「框1」的用户被 case override 置 enabled:false → 本节点整个不参与识别(框架跳过 disabled 节点)
    "家族天赋_锁槽1执行": {
        "timeout": 2500,
        "max_hit": 2,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/锁_开.png"
        ],
        "threshold": 0.9,
        // 实测(dual_slot_family.png)：槽1锁图标 (318,358)-(378,418)，四周留 6px 余量
        "roi": [
            312,
            352,
            72,
            72
        ],
        "action": "Click",
        "post_delay": 500,
        "next": [
            "家族天赋_锁槽确认",
            "家族天赋_锁槽判断"
        ]
    },
    // 槽2 同构：实测(dual_slot_family.png)锁图标 (318,432)-(378,492)，第二行比第一行低 74px
    "家族天赋_锁槽2执行": {
        "timeout": 2500,
        "max_hit": 2,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/锁_开.png"
        ],
        "threshold": 0.9,
        "roi": [
            312,
            426,
            72,
            72
        ],
        "action": "Click",
        "post_delay": 500,
        "next": [
            "家族天赋_锁槽确认",
            "家族天赋_锁槽判断"
        ]
    },
    // 锁定/解锁共用的确认框：文案不同(锁定「被锁定的属性不会被刷新更改…」/解锁「属性已解锁…」)
    // 但「确定」按钮同位置(实测 805,408)，同一个 ROI 能点到 → 复用一个节点，点完回锁槽判断
    "家族天赋_锁槽确认": {
        "timeout": 2500,
        "recognition": "OCR",
        "expected": [
            "^确定$"
        ],
        "roi": [
            700,
            375,
            220,
            70
        ],
        "action": "Click",
        "post_delay": 1000,
        "next": [
            "家族天赋_锁槽判断"
        ],
        "on_error": [
            "家族天赋_锁槽判断"
        ]
    },
    // ===== 钻石解锁守卫（未解锁槽防呆）=====
    // 槽位未解锁时，左栏该槽位显示的不是锁图标，而是「💎100 解锁新属性」绿色按钮
    //   (实测 lock_probe_state.png「我要打十个」：按钮横跨 (320,429)-(632,482)，第二槽位置没有锁图标)
    // 命中 = 目标槽位要靠 100 钻石解锁 → 本功能绝不替用户花钻石 → 钻石槽收尾 安全停止
    // 未命中 = 正常家族(两槽都有锁图标/已解锁属性) → 后续候选 双锁防呆 → 评估属性 正常接手
    // 与 锁槽2执行 的关系：这种家族槽2的 锁_开 模板本来就 miss(NCC 0.33) → 锁槽2执行自然放过，
    //   守卫接住并停手；槽1的锁图标正常命中(默认态会先锁槽1)，勾选保护先做完再停，逻辑自洽
    "家族天赋_钻石解锁守卫": {
        "timeout": 2000,
        "recognition": "TemplateMatch",
        "template": [
            "family_talent/解锁新属性.png"
        ],
        "threshold": 0.85,
        "roi": [
            310,
            420,
            340,
            70
        ],
        "only_rec": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_钻石槽收尾"
        ]
    },
    // 未解锁槽收尾：不点钻石解锁按钮，直接走已实测的收尾链(关弹窗 → 回家族页 → 回主页)安全结束
    "家族天赋_钻石槽收尾": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "focus": "目标槽位未解锁（显示钻石解锁按钮），本功能不自动解锁（需100钻石），已安全停止",
        "next": [
            "家族天赋_关闭弹窗"
        ]
    },
    // 双锁防呆(CustomRecognition FamilyTalentDoubleLockCheck, agent/family_talent.py)：
    //   右栏两个槽都显示「属性不会刷新」= 一个能刷的槽都没有(两个框位都没勾时可能锁成这样)
    //   为什么按行给 ROI：实测整块右栏 [660,300,340,180] 送 OCR 只返回一个 score=0、空文本的框；
    //   按行 [660,350,330,60] 能稳定读出「属性不会刷新」(score 0.99)
    //   命中 → 双锁收尾安全停止；未命中(正常 0 或 1 个锁) → 落到下一个候选「评估属性」
    "家族天赋_双锁防呆": {
        "timeout": 2000,
        "action": "DoNothing",
        "recognition": "Custom",
        "custom_recognition": "FamilyTalentDoubleLockCheck",
        "custom_recognition_param": {
            "槽1区": [
                660,
                350,
                330,
                60
            ],
            "槽2区": [
                660,
                420,
                330,
                60
            ]
        },
        "next": [
            "家族天赋_双锁收尾"
        ]
    },
    "家族天赋_双锁收尾": {
        "action": "DoNothing",
        "focus": "[color:Orange]两个槽位都显示「属性不会刷新」：刷新的框位一个都没勾，没有可刷新的槽位，已安全停止(未消耗刷新次数)[/color]",
        "next": [
            "家族天赋_关闭弹窗"
        ]
    },
    // 刷新计数：每进一次这里算一次刷新机会；max_hit 9 = 3 次免费 + 最多 6 次卡刷 = 9 次上限
    //   免费次数耗尽后由防钻石守卫把流程导向卡链，卡刷次数由卡闸门自身 max_hit 6 限制
    // timeout 2s 的用途：唯一候选「防钻石守卫」在免费态是未命中的(inverse)，靠超时把流程交给本节点的
    // on_error → 执行刷新；付费态则守卫立即命中 → 走守卫自己的 next(广告卡闸门/安全收尾)
    "家族天赋_刷新计数": {
        "timeout": 2000,
        "action": "DoNothing",
        "max_hit": 9,
        "next": [
            "家族天赋_防钻石守卫"
        ],
        "on_error": [
            "家族天赋_执行刷新",
            "家族天赋_未达标收尾"
        ]
    },
    // 钻石安全第一道闸。inverse 语义(协议原文)：识别到了当做没识别到，没识别到的当做识别到了
    //   only_rec=true 只识别不点击
    //   命中   = 刷新按钮左半区没有「免费」字样 → 钻石付费态 → 绝不点 → 走广告卡闸门(option 开了才有)或安全收尾
    //   未命中 = 左半区有「免费」字样 → 免费态 → 刷新计数的 next 全部未命中并超时 → on_error → 执行刷新
    "家族天赋_防钻石守卫": {
        "recognition": "OCR",
        "expected": [
            "免费"
        ],
        "roi": [
            710,
            530,
            120,
            65
        ],
        "only_rec": true,
        "inverse": true,
        "action": "DoNothing",
        "next": [
            "家族天赋_免广告卡闸门",
            "家族天赋_未达标收尾"
        ]
    },
    // 免广告卡闸门：option「使用免广告卡」把它覆盖成 enabled=true / max_hit=6
    // enabled=false(默认) 时它作为 next 候选会被框架跳过(协议：disabled 节点不识别不执行) → 默认走不到卡链
    // max_hit 用尽后同样被跳过 → 回到防钻石守卫 next 的第二候选「未达标收尾」
    // on_error：广告按钮识别/点击迟迟不成功(next 候选超时)时兜底走未达标收尾，不留在弹窗里静默结束
    "家族天赋_免广告卡闸门": {
        "enabled": false,
        "max_hit": 1,
        "action": "DoNothing",
        "next": [
            "家族天赋_点击观看广告刷新"
        ],
        "on_error": [
            "家族天赋_未达标收尾"
        ]
    },
    // 用户实测确认(2026-09-22)：有免广告次数时点「观看广告刷新」**直接刷新**，不弹广告确认窗；
    // 如果刷出的属性优秀，会弹「优秀属性」覆盖确认框(与免费刷新共用 覆盖确认 节点处理)
    // → 点完直接等属性刷新，广告确认窗节点已删除
    // timeout 8s：卡用完后按钮可能变灰/消失，8 秒内点不到就走 on_error 收尾回主页，
    // 配合卡闸门 max_hit=6(用户拍板)，最多尝试 6 次后必然退出卡链
    "家族天赋_点击观看广告刷新": {
        "timeout": 8000,
        "recognition": "OCR",
        "expected": [
            "观看广告刷新"
