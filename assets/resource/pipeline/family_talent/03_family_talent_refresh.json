            55
        ],
        "action": "Click",
        "post_delay": 800,
        "next": [
            "家族天赋_覆盖确认",
            "家族天赋_等待属性刷新"
        ],
        "on_error": [
            "家族天赋_未达标收尾"
        ]
    },
    // 钻石安全第二道闸：And 组合识别(两个 OCR 同时命中才算)，按钮必须同时含「免费」和「刷新」
    //   「刷新」ROI 取按钮右半区，避开左边可能出现的钻石图标
    //   两个条件都要求识别到(非 inverse)：只要有一个不满足就 miss，绝不点钻石按钮
    // 找不到免费刷新按钮 = 异常或付费态漏判 → 走安全收尾
    // 实测(2026-09-22)：免费态按钮文案是「免费刷新」整词 box[752,540,148,42]，两个 ROI 都能命中
    "家族天赋_执行刷新": {
