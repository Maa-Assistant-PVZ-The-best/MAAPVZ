{
    //==========================================================
    //无尽局内种植调度（作业集驱动）
    //
    //★ 本文件的 custom_action_param / next **全部由 JobSetFight 在运行时重写**。
    //  下面写的是「首帧兜底」形态，只为让 pipeline 能解析、节点存在。
    //
    //执行流程：
    //  无尽局内_单次种植  (链首，按 slotOrder 顺序)
    //     └─ 各槽组合动作_单次 → next: [无尽局内_继续挑战, 链里下一个动作]
    //  无尽局内_循环种植  (单次链跑完后进入)
    //     └─ 各槽组合动作_循环 → next: [无尽局内_继续挑战, 循环链下一个动作]
    //  无尽局内_继续挑战  = 结算画面出现「继续挑战」→ 点击 → 判断是否换阵容
    //
    //★ 不用 on_error：它靠「识别超时」触发，每次都要等满 timeout 并反复截图。
    //  「继续挑战」放在 next 第一位，识别不到就自然落到第二位（链里下一个动作）。
    //==========================================================
    "无尽局内_单次种植": {
        "action": "Custom",
        "custom_action": "JobSetFight",
        "custom_action_param": {
            "是boss关": false,
            // 滑动时长 100ms：80ms 时连续滑动会「第二个滑不出来」
            // （游戏端手势结算不过来），实测 100ms 稳定
            "滑动时长": 100
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": []
    },
    "无尽局内_循环种植": {
        "action": "Custom",
        "custom_action": "JobSetFight",
        "custom_action_param": {
            "是boss关": false,
            "滑动时长": 100
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": []
    },
    //==========================================================
    //结算画面：识别到「继续挑战」就点击，然后回到「开始战斗」再进一局。
    //这是一局结束时才出现的画面，所以**不需要分单次/循环**。
    //
    //★ 点击继续挑战后，游戏回到「选卡界面」，要再点一次开始战斗才能进关。
    //
    //  ★★ 完整闭环（砍掉 OCR 识别之后）：
    //    继续挑战 → 【无尽局内_过关计数：计数器 +1】
    //             → 选取植物_开始战斗 → 进入到局内
    //             → 识别boss关(头像模板匹配) → 计数器就近对齐5的倍数
    //             → 按计数器选表 →（表变了？局外换卡 : 直接种）
    //
    //  ★ 为什么计数挂在「点继续挑战」之后：
    //    「只要点了就必定是下一关了」—— 不需要任何判断。
    //    而**重开不会走这里**（重开走 通用_重开_暂停），所以天然不会误 +1。
    //==========================================================
    "无尽局内_继续挑战": {
        "recognition": "OCR",
        "expected": "继续挑战",
        "roi": [
            716,
            621,
            179,
            50
        ],
        "action": "Click",
        "pre_delay": 800,
        "post_delay": 300,
        "next": [
            "无尽局内_过关_正赛"
        ]
    },
    "无尽训练_继续训练": {
        "recognition": "OCR",
        "expected": "继续训练",
        "roi": [
            776,
            621,
            227,
            78
        ],
        "action": "Click",
        "pre_delay": 800,
        "post_delay": 300,
        // ★ 训练模式同样先计数（它也是「点完就是下一关」）
        "next": [
            "无尽局内_过关_训练"
        ]
    },
    // ---- 正赛：计数 + 播报 + 判断阵容（表没变就直接开打）----
    "无尽局内_过关_正赛": {
        "action": "Custom",
        "custom_action": "JobSetPlan",
        "custom_action_param": {
            "训练模式": false,
            "计数": true
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "无尽挑战_跳转_未变",
            "无尽挑战_跳转_变化"
        ]
    },
    // ---- 训练：同样，但无条件换阵 ----
    "无尽局内_过关_训练": {
        "action": "Custom",
        "custom_action": "JobSetPlan",
        "custom_action_param": {
            "训练模式": true,
            "计数": true
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "无尽挑战_跳转_未变",
            "无尽挑战_跳转_变化"
        ]
    },
    // ---- 跳转闸门：**故意不写 recognition** -> 默认 DirectHit，永远命中 ----
    //      走哪条由 JobSetPlan 翻 enabled 决定。
    "无尽挑战_跳转_未变": {
        "enabled": true,
        "next": [
            "无尽局内_补给",
            "无尽挑战_选取植物_开始战斗",
            "无尽挑战_完成"
        ]
    },
    "无尽挑战_跳转_变化": {
        "enabled": false,
        "next": [
            "无尽局内_补给",
            "无尽挑战_识别开始战斗_清空卡牌",
            "无尽挑战_完成"
        ]
    },
    "无尽挑战_完成": {
        "recognition": "OCR",
        "expected": [
            "最后一关"
        ],
        "roi": [
            425,
            332,
            424,
            101
        ],
        "action": "StopTask",
        "focus": "无尽挑战已完成！"
    }
}