{
    //==========================================================
    //无尽局内种植调度（作业集驱动）
    //
    //★ 本文件的 custom_action_param / next **全部由 JobSetFight 在运行时重写**。
    //  下面写的是「首帧兜底」形态，只为让 pipeline 能解析、节点存在。
    //
    //执行流程：
    //  无尽局内_单次种植  (链首，按 slotOrder 顺序)
    //     └─ 各槽组合动作_单次 → next: [无尽局内_继续挑战, 链里下一个动作]
    //  无尽局内_循环种植  (单次链跑完后进入)
    //     └─ 各槽组合动作_循环 → next: [无尽局内_继续挑战, 循环链下一个动作]
    //  无尽局内_继续挑战  = 结算画面出现「继续挑战」→ 点击 → 判断是否换阵容
    //
    //★ 不用 on_error：它靠「识别超时」触发，每次都要等满 timeout 并反复截图。
    //  「继续挑战」放在 next 第一位，识别不到就自然落到第二位（链里下一个动作）。
    //==========================================================
    "无尽局内_单次种植": {
        "action": "Custom",
        "custom_action": "JobSetFight",
        "custom_action_param": {
            "是boss关": false,
            // 滑动时长 100ms：80ms 时连续滑动会「第二个滑不出来」
            // （游戏端手势结算不过来），实测 100ms 稳定
            "滑动时长": 100
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "无尽挑战_铲子组合动作_单次"
        ]
    },
    "无尽局内_循环种植": {
        "action": "Custom",
        "custom_action": "JobSetFight",
        "custom_action_param": {
            "是boss关": false,
            "滑动时长": 100
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "无尽挑战_一槽组合动作_循环"
        ]
    },
    //==========================================================
    //结算画面：识别到「继续挑战」就点击，然后回到「开始战斗」再进一局。
    //这是一局结束时才出现的画面，所以**不需要分单次/循环**。
    //
    //★ 点击继续挑战后，游戏回到「选卡界面」，要再点一次开始战斗才能进关。
    //  不能直接跳「判断是否换阵容」——那一步依赖「天数识别」的结果，
    //  而天数只有进关之后才看得到。
    //
    //  完整闭环：
    //    继续挑战 → 选取植物_开始战斗 → 进入到局内 → 识别天数(计数器融合)
    //             → 识别boss关 → 判断是否换阵容 →（要换？重开重选 : 直接种）
    //==========================================================
    "无尽局内_继续挑战": {
        "recognition": "OCR",
        "expected": "继续挑战",
        "roi": [
            716,
            621,
            179,
            50
        ],
        "action": "Click",
        "pre_delay": 800,
        "post_delay": 300,
        "next": [
            "无尽局内_补给",
            "无尽挑战_选取植物_开始战斗"
        ]
    }
}