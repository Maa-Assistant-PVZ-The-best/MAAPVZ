{
    //直接run这里面的pipe节点，大大方方run
    //植物探险里，不管怎么滑动，这俩世界都是可以获取到的，所以可以以这俩世界为锚点，决定自己该怎么滑动
    "植物探险_寻找海盗/埃及": {
        "action": "Custom",
        "custom_action": "run_and_back",
        "custom_action_param": {
            "run": "植物探险_查找世界_入口",
            "pipe_over": {
                "植物探险_查找世界_入口": {
                    "next": [
                        "植物探险_点击海盗/埃及",
                        "植物探险_识别_上部分",
                        "植物探险_识别_下部分"
                    ]
                },
                "植物探险_识别_上部分": {
                    "next": [
                        "植物探险_世界翻页_上翻"
                    ]
                },
                "植物探险_识别_下部分": {
                    "next": [
                        "植物探险_世界翻页_上翻"
                    ]
                },
                "植物探险_世界翻页_上翻": {
                    "next": [
                        "植物探险_点击海盗/埃及",
                        "植物探险_识别_上部分",
                        "植物探险_识别_下部分"
                    ]
                }
            }
        }
    },
