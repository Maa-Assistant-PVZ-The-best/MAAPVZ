{
    "识别成功，启动！": {
        "timeout": 500000,
        "recognition": "TemplateMatch",
        "template": [
            "pair_duel/双人对决_开始匹配.png"
        ],
        "action": "Click",
        "next": [
            "识别局内",
            "突发情况处理"
        ]
    },
    "识别局内": {
        "rate_limit": 2000,
        "recognition": "TemplateMatch",
        "template": [
            "pair_duel/双人对决_局内.png"
        ],
        "action": "DoNothing",
        "focus": "[color:darkgray]开始匹配[/color]",
        "next": [
            "准备卡双赢"
        ],
        "on_error": [
            "突发情况处理"
        ]
    }, //这一段
    "准备卡双赢": {
        "action": "DoNothing",
        "next": [
            "下拉通知栏"
        ]
    },
    "下拉通知栏": {
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "cmd statusbar expand-notifications"
            }
        },
        "post_delay": 4500,
        "next": [
            "返回游戏"
        ]
    },
    "返回游戏": {
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "cmd statusbar collapse"
            }
        },
        "post_delay": 1000,
        "next": [
            "识别是否掉血",
            "下拉通知栏"
        ]
    }, //到这一段
    "识别是否掉血": {
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "ColorMatch",
                "lower": [
                    50,
                    245,
                    34
                ],
                "upper": [
                    195,
                    255,
                    87
                ],
                "roi": [
                    534,
                    367,
                    169,
                    27
                ]
            }
        ],
        "inverse": true,
        "post_delay": 0,
        "pre_delay": 400,
        "next": [
            "放置远程一号位植物1",
            "放置近战一号位植物1"
        ]
    }
}