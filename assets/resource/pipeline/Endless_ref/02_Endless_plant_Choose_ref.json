    //==========================================================
    //确认自己当前阶段
    //
    //一个 custom 干完三件事：取计数器关卡 -> boss 对齐 -> 判断是否换阵容。
    //（天数 OCR 已砍：关卡号完全由「起始关卡 + 过关计数」推导。）
    //
    //★ 用户明确的语义：
    //  本次任务里**第一次**识别到「属于另一张表」的天数时（例如表2 是 50~149），
    //  **不增加计数**，而是用「通用暂停」重开，把作业集切换成表2 的阵容与种植逻辑，
    //  然后继续开始游戏，走表2 的种植流程。
    //  之后同表内的关卡按正常的「计数 + 得分期望」推进。
    //
    //「通用_重开_暂停」跑完后由它的 [Anchor]下一个动作 回到本节点之后的 next。
    //==========================================================
    "无尽挑战_确认自己当前阶段": {
        "action": "Custom",
        "custom_action": "JobSetStage",
        "custom_action_param": {
            // 换阵容时调用的通用重开
            "通用重开节点": "通用_重开_暂停",
            // ★ 重开完成后跳回这里，重新走完整选卡流程
            //   （清空卡牌 -> 选取植物 -> 开始战斗 -> 进入局内）
            "重开后回跳节点": "无尽挑战_识别开始战斗_清空卡牌"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "无尽局内_单次种植"
        ]
    },
