{

    "创意庭院_分享_前置检查": {
        // 分享选项关闭时禁用本节点；max_hit 限制同一任务内重复创建关卡。
        "recognition": "OCR",
        "expected": ["创作关卡"],
        "roi": [516, 37, 226, 69],
        "post_wait_freezes": 500,
        "action": "DoNothing",
        "enabled": true,
        "max_hit": 1,
        "next": [
            "创意庭院_分享_建关"
        ]
    },

    "创意庭院_分享_建关": {
        // 复用主流程的建关链（创建关卡 → 选砸罐子 → 选坚果 → 起名 → 关配置窗），
        // 只在这次子跑里把关卡名换成 share；走到「创意庭院_砸罐子_挑战」之前截断，
        // 回到本节点后由分享链自己找 share 卡片（share.png）继续。
        // 不给本节点加 max_hit：run 指向自己时子跑会再进一次本节点；防重入靠 前置检查 的 max_hit。
        "action": "Custom",
        "custom_action": "run_and_back",
        "custom_action_param": {
            "run": "创意庭院_分享_建关",
            "back": "创意庭院_砸罐子_挑战",
            "pipe_over": {
                "创意庭院_分享_建关": {
                    "next": [
                        "创意庭院_创建关卡",
                        "创意庭院_创建关卡_滑动"
                    ]
                },
                "创意庭院_选择砸罐子_输入名字": {
                    // 使用英文关卡名以兼容 Android input text
                    "action": {
                        "type": "Shell",
                        "param": {
                            "cmd": "input text share"
                        }
                    }
                },
                "创意庭院_砸罐子_输入名字_确认": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "share"
                            ]
                        }
                    }
                },
                "创意庭院_选择砸罐子_关闭": {
                    // 关窗后给「自动配置」提示一点出现的时间，否则截断桩会先命中
                    "post_delay": 1500
                }
            }
        },
        "next": [
            "创意庭院_分享_卡片_点分享_挑战",
            "创意庭院_分享_回到列表页",
            "创意庭院_分享_系统提示_自动配置"
        ]
    },

    "创意庭院_分享_系统提示_自动配置": {
        // 处理结束后进入列表页识别，避免与关闭设置窗互相跳转。
        "recognition": "OCR",
        "expected": ["自动配置"],
        "roi": [470, 495, 170, 60],
        "action": "Click",
        "max_hit": 1,
        "timeout": 8000,
        "post_delay": 1500,
        "next": ["创意庭院_分享_卡片_点分享_挑战"]
    },

    "创意庭院_分享_回到列表页": {
        "recognition": "OCR",
        "expected": ["创作关卡"],
        "roi": [400, 30, 480, 80],
        "action": "DoNothing",
        "timeout": 8000,
        "post_delay": 1000,
        "next": ["创意庭院_分享_卡片_点分享_挑战"]
    },

    "创意庭院_分享_卡片_点分享_挑战": {
        // 卡片需依次进入挑战、发布和刷新阶段，分开节点以保持各自出口。
        "recognition": "TemplateMatch",
        "template": ["create_yard/share.png"],
        "roi": [390, 158, 115, 100],
        "threshold": 0.8,
        "action": "Click",
        "target": [444, 235],
        "timeout": 10000,
        "max_hit": 1,
        "post_delay": 2500,
        "next": ["创意庭院_分享_挑战_进入"]
    },

    "创意庭院_分享_点关卡并发布": {
        // 卡片位置可能变化，由自定义动作定位并区分发布状态。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ShareClickLevelPublish",
                "custom_action_param": {
                    "template": "create_yard/share.png",
                    "card_roi": [340, 140, 740, 220],
                    "publish_roi": [330, 540, 180, 100],
                    "confirm_roi": [480, 450, 340, 130],
                    "threshold": 0.8
                }
            }
        },
        "timeout": 30000,
        "next": ["创意庭院_分享_发布_关闭"]
    },

    "创意庭院_分享_卡片_点分享_刷新": {
        // 发布后重新进入详情页，刷新分享入口。
        "recognition": "TemplateMatch",
        "template": ["create_yard/share.png"],
        "roi": [390, 158, 115, 100],
        "threshold": 0.8,
        "action": "Click",
        "target": [444, 235],
        "timeout": 10000,
        "max_hit": 1,
        "post_delay": 2500,
        "next": ["创意庭院_分享_点分享"]
    },

