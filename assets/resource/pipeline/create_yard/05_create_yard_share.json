            "type": "Shell",
            "param": {
                "cmd": "am force-stop com.tencent.mobileqq"
            }
        },
        "pre_delay": 500,
        "post_delay": 1500,
        "next": ["创意庭院_分享_成功_确定", "创意庭院_分享_回到预览层"]
