    // ===== 同一个卡片要进详情页三次，各做一件事 =====
    // 拆成三个节点而非一个配 max_hit=3：max_hit 按节点累计，共用时第二次可能已被跳过。
    // 识别完全相同（都用 share.png 卡片印章图，实测 score 1.0000），只是出口不同。
    "创意庭院_分享_卡片_点分享_挑战": {
        "recognition": "TemplateMatch",
        "template": ["create_yard/share.png"],
        "roi": [390, 158, 115, 100],
        "threshold": 0.8,
        "action": "Click",
        "target": [444, 235],
        "timeout": 10000,
        "max_hit": 1,
        "post_delay": 2500,
        "next": ["创意庭院_分享_挑战_进入"]
    },

    "创意庭院_分享_点关卡并发布": {
        // 列表页点「未发布」卡片 → 发布 → 清确认弹窗，交给 agent 识图：
        // 卡片位置不固定（残留的幽灵关卡会随机排序），「发布/已发布」又要精确等值。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ShareClickLevelPublish",
                "custom_action_param": {
                    "template": "create_yard/share.png",
                    "card_roi": [340, 140, 740, 220],
                    "publish_roi": [330, 540, 180, 100],
                    "confirm_roi": [480, 450, 340, 130],
                    "threshold": 0.8
                }
            }
        },
        "timeout": 30000,
        "next": ["创意庭院_分享_发布_关闭"]
    },

