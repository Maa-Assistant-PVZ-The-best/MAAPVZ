{
    // 「分享到抖音」闭环：创建关卡 → 挑战 → 发布 → 刷新后点分享 → 选抖音 → 关抖音
    //                     → 领奖励 → 返回 → 删除该关卡 → 交回主流程（刷币/刷赞）
    //
    // 三个必须知道的机制（改本文件前先读）：
    //   1. max_hit 按「节点」累计，用尽即永久跳过。同一节点要走多遍必须拆成多个节点。
    //   2. target 写矩形时是正态分布采样（均值=中心、σ=宽/3），边界是软的：
    //      必须让「中心±宽」落在按钮内，否则概率性点空。[x,y] 才是精确点。
    //   3. [JumpBack] = 命中并执行完下游链后回到【父节点】重新识别 next，属循环重试。
    //      任何回跳链都必须有 max_hit 封顶，否则无限重跑。

    "创意庭院_分享_前置检查": {
        // 分享链入口，也是「分享到抖音」总开关：interface.json 的 No case 把它覆盖成
        // enabled:false，框架识别 next 时跳过禁用候选，于是 确认自己在创意庭院 直接落到
        // 后面的刷赞/刷币节点。
        // max_hit:1 不可删：本节点只认列表页标题，停在列表页会一直命中而无限重跑。
        "recognition": "OCR",
        "expected": ["创作关卡"],
        "roi": [516, 37, 226, 69],
        "post_wait_freezes": 500,
        "action": "DoNothing",
        "enabled": true,
        "max_hit": 1,
        "next": [
            "创意庭院_分享_创建关卡",
            "创意庭院_刷赞_创建关卡",
            "创意庭院_创建关卡",
            "创意庭院_创建关卡_滑动"
        ]
    },

