    "创意庭院_分享_关闭抖音": {
        // am force-stop 比按返回键可靠：不用猜次数，系统必然把游戏切回前台。
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "am force-stop com.ss.android.ugc.aweme"
            }
        },
        "pre_delay": 500,
        // 不能加 post_wait_freezes：本节点是 Shell 动作、没有识别框，
        // wait_freezes 拿不到参照矩形会报 failed to get target rect。
        // 切回前台后的等待由后面的 回到预览层 桥接节点承担。
        "post_delay": 1500,
        "next": ["创意庭院_分享_回到预览层"]
    },

    "创意庭院_分享_回到预览层": {
        // 桥接节点：只确认「已切回游戏、预览层已显示」，不点任何东西。
        // 关闭抖音 的 next 若只有 成功_确定，切回前台慢、弹窗没出来时父节点会超时结束任务。
        // 用「等画面出现」而非自引用重试 —— 不建议对同一按钮重复点击
        // （第二次点击可能作用到下一界面的其他元素）。锚点用预览层「返回」按钮。
        "recognition": "OCR",
        "expected": ["返回"],
        "roi": [821, 639, 117, 48],
        "action": "DoNothing",
        // 纯等待节点，显式归零避免引入隐式 1000ms 等待。
        "rate_limit": 0,
        "timeout": 15000,
        "next": ["创意庭院_分享_成功_确定"]
    },

    // ===== 回游戏后的两个弹窗，必须先点干净，否则会挡住底下的「返回」按钮 =====
    // 「分享成功」每次分享后都弹；「奖励统计」每天只弹一次（奖励已领就不再出现）。
    // 两者「确定」位置不同：分享成功中心约 (644,517) → roi 取 y 478~544；
    //                      奖励统计中心约 (637,573)、按钮 x 539~736 → roi 取 y 545~600。
    //
    // 【2026-10-16 实测 bug】奖励弹窗比「分享成功」晚渲染（实测晚约 10 秒）。
    // 当时 成功_确定 点完就把控制权交给 奖励_确定，而后者只被尝试 1 次（耗时 0ms）
    // 就落到兜底点了「返回」→ 奖励没领、返回被弹窗挡住、删除关卡识别不到而任务失败。
    //
    // 修法（两个节点都用「自引用重试」等晚渲染的弹窗，而不是靠一次识别碰运气）：
    //   成功_确定：next[0] 是自己，未成功就重点一次，max_hit:5 封顶，每次间隔 post_delay 500ms。
    //   奖励_确定：next[0] 也是自己，靠自己的 timeout 当重试窗口。
    // 【next 的顺序不能动】
    //   成功_确定.next = [自己, 奖励_确定, 返回]
    //   奖励_确定 只被 成功_确定 和它自己指向 —— 若把它从 成功_确定.next 移除，
    //   奖励弹窗就再也没有入口，奖励永远领不到。
    // 【不能互指】成功_确定 与 奖励_确定 之间必须单向，互指会每秒交替命中、父节点永不超时。
    // 【pre_wait_freezes 必需】截图截太快会匹配到未稳定画面（实测差 76px）。
    "创意庭院_分享_成功_确定": {
        "recognition": "OCR",
        "expected": ["确定"],
        "roi": [560, 478, 200, 66],
        "action": "Click",
        "pre_wait_freezes": 800,
        "timeout": 8000,
        "max_hit": 5,
        "post_wait_freezes": 800,
        "post_delay": 500,
        "next": [
            "创意庭院_分享_成功_确定",
            "创意庭院_分享_奖励_确定",
            "创意庭院_分享_返回"
        ]
    },

