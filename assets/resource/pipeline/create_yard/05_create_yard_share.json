    "创意庭院_分享_关闭抖音": {
        // Shell 动作没有识别框，不使用依赖识别框的 post_wait_freezes。
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "am force-stop com.ss.android.ugc.aweme"
            }
        },
        "pre_delay": 500,
        "post_delay": 1500,
        "next": ["创意庭院_分享_成功_确定", "创意庭院_分享_回到预览层"]
    },

    "创意庭院_分享_渠道_QQ": {
        // QQ 与抖音图标同时存在；由分享渠道选项禁用另一节点来选择渠道。
        "recognition": "TemplateMatch",
        "template": ["create_yard/qqshare.png"],
        "threshold": 0.8,
        "action": "Click",
        "timeout": 8000,
        "post_delay": 3000,
        "next": ["创意庭院_分享_关闭QQ"]
    },

