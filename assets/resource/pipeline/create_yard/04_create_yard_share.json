    "创意庭院_分享_切回_关闭抖音": {
        // 直接杀掉抖音进程（= 关掉抖音窗口），系统会自动把游戏切回前台，
        // 比按返回键更干脆：不用猜要按几次，也不会误退回桌面/误点。
        // 万一没切回来，后面还有「按返回键」的循环兜底。
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "am force-stop com.ss.android.ugc.aweme"
            }
        },
        "pre_delay": 300,
        "post_delay": 1000,
        "next": [
            "创意庭院_分享_切回_检测已回游戏",
            "创意庭院_分享_切回_安卓返回"
        ]
    },
    "创意庭院_分享_切回_安卓返回": {
        // 点抖音后会跳到抖音 App，按返回键回游戏（抖音冷启动时可能要按多次）。
        // 每轮只花约 0.6s 按键 + 0.6s 探测，探测命中即跳出循环。
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "input keyevent 4"
            }
        },
        "max_hit": 4,
        "rate_limit": 300,
