                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "原大_boss_判断是否进入关内": {
                            "next": [
                                "原大_boss_识别结算"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "原大_boss关喂豆位置"
                    ],
                    "pipeline_override": {
                        "原大_boss_判断是否进入关内": {
                            "next": [
                                "原大_boss_喂豆"
                            ]
                        }
                    }
                }
            ]
        },
        "原大_boss关喂豆位置": {
            "type": "input",
            "label": "行列坐标",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "9",
                    "verify": "^[1-9]$"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "1",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "原大_boss_喂豆": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
