                            "next": [
                                "原大_开棱镜塔",
                                "原大_点波5"
                            ]
                        }
                    }
                }
            ]
        },
        "原大_boss关是否需要喂豆": {
            "type": "switch",
            "label": "boss关是否需要喂豆",
