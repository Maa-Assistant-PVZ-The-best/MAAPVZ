{
    "option": {
        "原大_小关是否抛花": {
            "type": "switch",
            "label": "普通关是否抛花",
            "description": "抛花位置为右上角(9-1)(9-2)",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "原大_判断是否进入关内": {
                            "next": [
                                "原大_点波1"
                            ]
                        },
                        "原大_海盗_判断是否进入关内": {
                            "next": [
                                "原大_海盗_点波1"
                            ]
                        },
                        "原大_西部_判断是否进入关内": {
                            "next": [
                                "原大_西部_点波1"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "原大_判断是否进入关内": {
                            "next": [
                                "原大_抛花1"
                            ]
                        },
                        "原大_海盗_判断是否进入关内": {
                            "next": [
                                "原大_海盗_抛花1"
                            ]
                        },
                        "原大_西部_判断是否进入关内": {
                            "next": [
                                "原大_西部_抛花1"
                            ]
                        }
                    }
                }
            ]
        },
        "原大_是否开棱镜塔": {
            "type": "switch",
            "label": "小关是否棱镜塔",
            "description": "需要自己携带棱镜塔",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
