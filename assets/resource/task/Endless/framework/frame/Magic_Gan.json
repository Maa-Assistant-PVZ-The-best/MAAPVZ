{
    "option": {
        "是否魔甘收尾(牢玩家专属)": {
            "type": "switch",
            "label": "是否魔甘收尾(牢玩家专属)",
            "description": "魔音甜菜位于卡槽4,飓风甘兰位于卡槽5.甜薯位于卡槽6,魔音甜菜会种在9-3,飓风甘兰会种在7-2和7-4.甜薯种植在8-2和8-4",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "option": [
                        "多少秒后种魔甘",
                        "使用三叶草",
                        "魔甘高级选项"
                    ],
                    "label": "是",
                    "pipeline_override": {
                        "frame_wj_划飞弹": {
                            "next": [
                                "判断是否魔甘收尾"
                            ]
                        }
                    }
                }
            ]
        },
        "魔甘高级选项": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "识别魔甘卡槽位置",
                        "魔甘前使用能量豆",
                        "甜薯1种植位置",
                        "甜薯2种植位置",
                        "飓风甘蓝1种植位置",
                        "飓风甘蓝2种植位置",
                        "魔甘失败后是否重开"
                    ]
                }
            ]
        },
        "魔甘失败后是否重开": {
            "type": "switch",
            "description": "有气流水仙花可以关闭",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "无尽框架_结算超时_重开_暂停": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "甜薯1种植位置": {
            "type": "input",
            "label": "甜薯1种植位置",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "8",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "2",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "种甜薯1": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "甜薯2种植位置": {
            "type": "input",
            "label": "甜薯2种植位置",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "8",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "4",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "种甜薯2": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "飓风甘蓝1种植位置": {
            "type": "input",
            "label": "飓风甘蓝1种植位置",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "7",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "2",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "种甘兰1": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "飓风甘蓝2种植位置": {
            "type": "input",
            "label": "飓风甘蓝2种植位置",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "7",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "4",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "种甘兰2": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "多少秒后种魔甘": {
            "type": "input",
            "description": "左边旗子升起后，等待怪全部出完（然后种魔甘）的时间，秒为单位，默认15秒",
            "inputs": [
                {
                    "name": "秒",
                    "pipeline_type": "int",
                    "default": "15",
                    "verify": ""
                }
            ],
            "pipeline_override": {
                "魔甘收尾": {
                    "post_delay": "{秒}000"
                }
            }
        },
        "使用三叶草": {
            "type": "switch",
            "description": "三叶草要在第七格，种植在9-5",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "识别三叶草卡槽位置"
                    ],
                    "pipeline_override": {
                        "种三叶草": {
                            "enable": true
                        }
                    }
                }
            ]
        },
        "魔甘前使用能量豆": {
            "type": "switch",
            "description": "位置选择",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "魔甘前喂豆位置"
                    ],
                    "pipeline_override": {
                        "魔甘前喂豆": {
                            "enable": true
                        }
                    }
                }
            ]
        },
        "魔甘前喂豆位置": {
            "type": "input",
            "label": "魔甘前喂豆位置",
            "description": "输入喂豆的目标格子坐标",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "3",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9的数字"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "3",
                    "verify": "^[1-5]$",
                    "pattern_msg": "请输入1-5的数字"
                }
            ],
            "pipeline_override": {
                "魔甘前喂豆": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        }
    }
}