                    "verify": "^[1-9]$"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "5",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "frame_wj_boss_抛花4": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        }
    }
