{
    "option": {
        "是否抛花": {
            "type": "switch",
            "description": "是否在小关和boss关使用能量花，默认卡槽1为能量花",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_boss_判断是否进入关内": {
                            "next": [
                                "frame_wj_boss_过渡_相机神器1"
                            ]
                        },
                        "frame_wj_判断是否进入关内": {
                            "next": [
                                "frame_wj_捡花1"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "小关是否抛花",
                        "boss关是否抛花",
                        "识别能量花卡槽位置"
                    ]
                }
            ]
        },
        "小关是否抛花": {
            "type": "switch",
            "label": "小关是否抛花",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_判断是否进入关内": {
                            "next": [
                                "frame_wj_捡花1"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "1花位置",
                        "2花位置"
                    ],
                    "pipeline_override": {
                        "frame_wj_boss_判断是否进入关内": {
                            "next": [
                                "frame_wj_boss_抛花1"
                            ]
                        },
                        "frame_wj_判断是否进入关内": {
                            "next": [
                                "frame_wj_抛花1"
                            ]
                        }
                    }
                }
            ]
        },
        "1花位置": {
            "type": "input",
            "label": "行列坐标",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "7",
                    "verify": "^[1-9]$"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "1",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "frame_wj_抛花1": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "2花位置": {
            "type": "input",
            "label": "行列坐标",
            "inputs": [
                {
                    "name": "列",
                    "pipeline_type": "string",
                    "default": "7",
                    "verify": "^[1-9]$"
                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "2",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "frame_wj_抛花2": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
        },
        "boss关是否抛花": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "frame_wj_boss_判断是否进入关内": {
                            "next": [
                                "frame_wj_boss_过渡_相机神器1"
                            ]
                        },
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "boss关_1花位置",
                        "boss关_2花位置",
                        "boss关_3花位置",
                        "boss关_4花位置"
                    ]
                }
