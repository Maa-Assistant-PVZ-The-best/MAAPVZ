                },
                {
                    "name": "行",
                    "pipeline_type": "string",
                    "default": "2",
                    "verify": "^[1-5]$"
                }
            ],
            "pipeline_override": {
                "frame_wj_boss_抛花1": {
                    "end": "种植物_初始化_格子{列}_{行}"
                }
            }
