{
    "option": {
        "增加次数": {
            "type": "switch",
            "label": "增加探险次数",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_加号1": {
                            "enabled": true
                        },
                        "植物探险_加号2": {
                            "enabled": true
                        },
                        "植物探险_加号3": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "立即完成": {
            "type": "switch",
            "label": "立即完成",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_立即完成1": {
                            "enabled": true
                        },
                        "植物探险_立即完成2": {
                            "enabled": true
                        },
                        "植物探险_立即完成3": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "立即完成次数"
                    ]
                }
            ]
        },
        "立即完成次数": {
            "type": "input",
            "label": "立即完成次数",
            "inputs": [
                {
                    "name": "立即完成次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "植物探险_立即完成1": {
                    "max_hit": "{立即完成次数}"
                },
                "植物探险_立即完成2": {
                    "max_hit": "{立即完成次数}"
                },
                "植物探险_立即完成3": {
                    "max_hit": "{立即完成次数}"
                }
            }
        },
        "双倍碎片": {
            "type": "switch",
            "label": "双倍碎片",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_双倍碎片": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "探险消耗来源": {
            "type": "checkbox",
            "label": "探险消耗来源",
            "min_count": 1,
            "default_case": [
                "免广告卡"
            ],
            "cases": [
                {
                    "name": "免广告卡",
                    "pipeline_override": {
                        "植物探险_用卡_立即完成": {
                            "enabled": true
                        },
                        "植物探险_用卡_加次数1": {
                            "enabled": true
                        },
                        "植物探险_用卡_加次数2": {
                            "enabled": true
                        },
                        "植物探险_用卡_加次数3": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "使用钻石",
                    "pipeline_override": {
                        "植物探险_用钻_立即完成": {
                            "enabled": true
                        },
                        "植物探险_用钻_加次数1": {
                            "enabled": true
                        },
                        "植物探险_用钻_加次数2": {
                            "enabled": true
                        },
                        "植物探险_用钻_加次数3": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}