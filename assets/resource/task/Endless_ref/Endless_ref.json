{
    "option": {
        "作业集模式": {
            "type": "select",
            "default_case": "编辑作业集",
            "cases": [
                {
                    "name": "编辑作业集",
                    "pipeline_override": {
                        "无尽挑战_前置检查_ref": {
                            "next": [
                                "无尽挑战_编辑作业集"
                            ]
                        }
                    }
                },
                {
                    "name": "使用远程作业集(别用)",
                    "option": [
                        "作业集代码",
                        "无尽模式_重构",
                        "无尽挑战_选择世界",
                        "无尽_起始关卡"
                    ]
                },
                {
                    "name": "使用本地作业集",
                    "option": [
                        "无尽模式_重构",
                        "无尽挑战_选择世界"
                    ]
                }
            ]
        },
        //==========================================================
        //★ 起始关卡 —— 作业集计数器的起点
        //
        //  砍掉 OCR 识别之后，关卡号完全由「起始关卡 + 过关次数」推出，
        //  所以这个值是**必需的**：不填 -> 计数器从 0 起 -> 表选择会落回第 1 张表。
        //
        //  含义：**当前正在打的这一关**。
        //    填 87 -> 第一局就是 87 关，打完点「继续挑战」变 88。
        //
        //  这个 override 指向 JobSetLoad 的 custom_action_param，
        //  运行时用 from_params() 读 "起始关卡" 这一个键。
        //
        //  ★ verify 必须是**数字范围**校验（不是 .{1,149}）。
        //    1-149 的正则写法：1 位/2 位任意，或 3 位里 100-149。
        //      ^([1-9]|[1-9][0-9]|1[0-4][0-9])$   -> 1-149
        //==========================================================
        "何处开启": {
            "type": "select",
            "cases": [
                {
                    "name": "主界面",
                    "pipeline_override": {
                        "让我看看我在不在开始战斗界面奥": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "关内",
                    "description": "需要手动填写起始关卡",
                    "option": [
                        "无尽_起始关卡"
                    ]
                }
            ]
        },
        "无尽_起始关卡": {
            "type": "input",
            "label": "起始关卡（当前正在打的这一关）",
            "description": "填你当前所在的关卡（1-149）。计数器从这里开始逐关推进；进 boss 关时会自动对齐到 5 的倍数。",
            "inputs": [
                {
                    "name": "起始关卡",
                    "pipeline_type": "int",
                    "default": "",
                    "verify": "^([1-9]|[1-9][0-9]|1[0-4][0-9])$",
                    "pattern_msg": "请输入 1-149 之间的整数"
                }
            ],
            "pipeline_override": {
                "无尽挑战_加载作业集代码": {
                    "custom_action_param": {
                        "重置": true,
                        "起始关卡": "{起始关卡}"
                    }
                }
            }
        },
        "作业集代码": {
            "type": "input",
            "inputs": [
                {
                    "name": "代码",
                    "pipeline_type": "string",
                    "default": ""
                }
            ]
        },
