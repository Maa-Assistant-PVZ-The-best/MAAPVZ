{
    "option": {
        "增加次数": {
            "type": "switch",
            "label": "增加探险次数",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_定位_增加次数": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "立即完成": {
            "type": "switch",
            "label": "立即完成",
            "description": "只使用免广告卡的话建议将次数设置为1或者2",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_立即完成": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "立即完成次数"
                    ]
                }
            ]
        },
        "立即完成次数": {
            "type": "input",
            "label": "立即完成次数",
            "inputs": [
                {
                    "name": "立即完成次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "植物探险_立即完成": {
                    "max_hit": "{立即完成次数}"
                }
            }
        },
        "双倍碎片": {
            "type": "switch",
            "label": "双倍碎片",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "植物探险_双倍碎片": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "探险消耗来源": {
            "type": "checkbox",
            "label": "探险消耗来源",
            "min_count": 1,
            "default_case": [
                "免广告卡"
            ],
            "cases": [
                {
                    "name": "免广告卡",
                    "pipeline_override": {
                        "植物探险_使用免广告卡_ref": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "使用钻石",
                    "description": "谨慎开启，会消耗你的钻石资源",
                    "pipeline_override": {
                        "植物探险_使用钻石": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}