        "应用宝_登录方式": {
            "label": "登录方式",
            "type": "select",
            "cases": [
                {
                    "name": "qq登录",
                    "pipeline_override": {
                        "打开pvz_识别登录": {
                            "next": [
                                "打开pvz_点击登录_应用宝_qq",
                                "[JumpBack]点击登录_jumpback_关闭广告"
                            ]
                        }
                    }
                },
                {
                    "name": "微信登录",
                    "pipeline_override": {
                        "打开pvz_识别登录": {
                            "next": [
                                "打开pvz_点击登录_应用宝_微信",
                                "[JumpBack]点击登录_jumpback_关闭广告"
                            ]
