{
    "option": {
        "存档覆盖进度": {
            "type": "select",
            "cases": [
                {
                    "name": "云端进度",
                    "pipeline_override": {
                        "开始游戏_使用本地进度": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "本地进度",
                    "pipeline_override": {
                        "开始游戏_使用云端进度": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "最新进度",
                    "pipeline_override": {
                        "开始游戏_最新进度": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "绑定设备": {
            "type": "switch",
            "description": "有时换设备登录需要绑定设置，可以开启此功能",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "点击登录_jumpback_绑定设备": {
                            "action": "Click"
                        }
                    }
                }
            ]
        },
        "开始登录_关闭广告": {
            "label": "关闭广告",
            "type": "switch",
            "description": "搜索控件树中的close字段并且点击，通常情况下这个ui控件是关闭按钮，也可能有例外",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "点击登录_jumpback_关闭广告": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "渠道服": {
            "type": "select",
