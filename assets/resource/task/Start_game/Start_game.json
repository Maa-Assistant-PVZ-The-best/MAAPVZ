        "自定义包名": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "输入_自定义包名"
                    ],
                    "pipeline_override": {
                        "打开pvz_自定义包": {
                            "enabled": true
                        },
                        "关闭pvz_自定义包": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "输入_自定义包名": {
            "type": "input",
            "label": "自定义包名",
            "description": "通常用于共存免绑包，请知道如何查询包名后使用，包名并非软件名字，也不是你的用户名",
            "inputs": [
                {
                    "name": "包名",
                    "label": "自己游戏的包名"
                }
            ],
            "pipeline_override": {
                "打开pvz_自定义包": {
                    "package": "{包名}"
                },
                "关闭pvz_自定义包": {
                    "package": "{包名}"
                }
            }
        },
        "关闭悬浮窗": {
            "type": "switch",
            "description": "会关闭资源预设配置中所选的渠道服，不过目前只适配了4399和华为渠道服（由于时效性的原因，建议以用户文档为准），maapvz的开发者由衷的欢迎你来帮忙提交pr！",
