{
    "option": {
        "使用免广告卡_ref": {
            "label": "使用免广告卡",
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "巨人危机_增加次数",
                        "邪恶入侵_增加次数"
                    ]
                }
            ]
        },
        "巨人危机_增加次数": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "巨人危机_难度选择_ref": {
                            "custom_action_param": {
                                "run": "巨人危机_增加次数_ref"
                            }
                        }
                    }
                }
            ]
        },
        "邪恶入侵_增加次数": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "邪恶入侵_难度选择_ref": {
                            "custom_action_param": {
                                "run": "邪恶入侵_增加次数_ref"
                            }
                        }
                    }
                }
            ]
        },
