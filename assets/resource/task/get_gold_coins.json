{
    "option": {
        "刷金币模式选择": {
            "type": "select",
            "default_case": "一直刷胜场/金币",
            "cases": [
                {
                    "name": "指定次数",
                    "description": "填几就打几场",
                    "option": [
                        "刷取次数"
                    ]
                },
                {
                    "name": "一直刷胜场/金币"
                }
            ]
        },
        "刷取次数": {
            "type": "input",
            "label": "刷取次数",
            "inputs": [
                {
                    "name": "刷取次数",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "^[1-9]\\d{0,2}$"
                }
            ],
            "pipeline_override": {
                "埃及1_次数入口": {
                    "max_hit": "{刷取次数}"
                },
                "功夫13_次数入口": {
                    "max_hit": "{刷取次数}"
                }
            }
        },
        "需要刷的关卡": {
            "type": "select",
            "cases": [
                {
                    "name": "埃及一",
                    "option": [
                        "刷金币模式选择"
                    ],
                    "pipeline_override": {
                        "点击星系": {
                            "next": [
                                "查找埃及世界",
                                "点击星系",
                                "星系滑动"
                            ]
                        },
                        "星系_进入世界": {
                            "next": [
                                "埃及1_寻找关卡特征"
                            ]
                        },
                        "星系滑动": {
                            "next": [
                                "查找埃及世界",
                                "点击星系",
                                "星系滑动"
                            ]
                        }
                    }
                },
                {
                    "name": "功夫13",
                    "description": "至少拥有街机神器，且升到九级或者以上",
                    "option": [
                        "装备街机神器",
                        "刷金币模式选择"
                    ],
                    "pipeline_override": {
                        "点击星系": {
                            "next": [
                                "查找功夫世界",
                                "星系滑动"
                            ]
                        },
                        "星系_进入世界": {
                            "next": [
                                "功夫13_定位"
                            ]
                        },
                        "星系滑动": {
                            "next": [
                                "查找功夫世界",
                                "星系滑动"
                            ]
                        }
                    }
                }
            ]
        },
        "装备街机神器": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "星系_进入世界": {
                            "next": [
                                "功夫13_点击植物"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}