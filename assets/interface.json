    "option": {
        "刷取类型": {
            "type": "select",
            "cases": [
                {
                    "name": "刷游玩币",
                    "option": [
                        "使用收藏关卡"
                    ],
                    "pipeline_override": {
                        "创意庭院_刷币_点击游玩": {
                            "enabled": true
                        },
                        "创意庭院_游玩_可刷取的代币已达上限": {
                            "enabled": true
                        },
                        "创意庭院_刷币_删完关卡_退出": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "刷点赞",
                    "option": [
                        "点赞几次"
                    ],
                    "pipeline_override": {
                        "创意庭院_刷赞_删除关卡": {
                            "enabled": true
                        },
                        "创意庭院_刷赞_创建关卡": {
                            "enabled": true,
                        },
                    }
                },
            ]
        },
        "点赞几次": {
            "type": "input",
            "inputs": [
                {
                    "name": "点赞次数",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "[1-9]\\d*$"
                },
            ],
            "pipeline_override": {
                "创意庭院_刷赞_重新创建关卡检测次数": {
                    "max_hit": "{点赞次数}"
                },
            }
        },
        "使用收藏关卡": {
            "type": "switch",
            "default_case": "No",
            "description": "使用第一个收藏的关卡",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "创意庭院_确认自己在创意庭院": {
                            "next": [
                                "创意庭院_使用收藏的关卡"
                            ]
                        },
                        "创意庭院_游玩_点赞_确定2": {
                            "next": [
                                "创意庭院_游玩_等待结算"
                            ]
                        },
                        "创意庭院_刷币_点击游玩": {
                            "next": [
                                "创意庭院_使用收藏的关卡"
                            ],
                        },
                        "创意庭院_游玩_点赞": {
                            "next": [
                                "创意庭院_游玩_等待结算"
                            ]
                        },
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "高级设置": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "选卡相关"
                    ]
                }
            ]
        },
        "选卡相关": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "选卡时滑动的持续时间",
                        "选卡滑动后的按住屏幕时间",
                        "选完植物时滑动到最顶上的时间"
                    ]
                }
            ]
        },
        "选完植物时滑动到最顶上的时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "[1-9]\\d*$"
                },
            ],
            "pipeline_override": {
                "滑回最顶上": {
                    "duration": "{滑动时间}",
                },
            }
        },
        "选卡时滑动的持续时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "200",
                    "verify": "[1-9]\\d*$"
                },
            ],
            "pipeline_override": {
                "寻找植物_滑动": {
                    "duration": "{滑动时间}",
                },
            }
        },
        "选卡滑动后的按住屏幕时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "50",
                    "verify": "[1-9]\\d*$"
                },
            ],
            "pipeline_override": {
                "寻找植物_滑动": {
                    "end_hold": "{滑动时间}",
                },
            }
        },
    }
}