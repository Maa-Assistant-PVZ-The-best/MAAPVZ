        "./resource/task/get_gold_coins/gold_coins.json",
        "./resource/task/star_game/start_game.json",
        "./resource/task/Secret_realm/secret_realm.json",
        "./resource/task/pair_duel/pair_duel.json",
        "./resource/task/mini_tools/mini_tools.json",
        "./resource/task/misc/logs.json",
        "./resource/task/video_card/video_card.json",
        // Endless 重构版入口
        "./resource/task/Endless_ref/endless_ref.json",
        // 植物探险（重构）：按层级拆分，序号即合并顺序
        "./resource/task/explore_ref/world.json",
        "./resource/task/explore_ref/plant.json",
        "./resource/task/explore_ref/source.json",
        "./resource/task/explore_ref/action.json",
        // 碎片挑战（重构）
        "./resource/task/Fragment_ref/fragment_ref.json",
        // 活动合集 / 创意庭院：option 已拆到各自目录
        "./resource/task/Activity/activity.json",
        "./resource/task/create_yard/create_yard.json"
    ],
