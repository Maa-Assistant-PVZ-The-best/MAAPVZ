    "option": {
        "高级设置": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "选卡相关"
                    ]
                }
            ]
        },
        "选卡相关": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "选卡时滑动的持续时间",
                        "选卡滑动后的按住屏幕时间",
                        "选完植物时滑动到最顶上的时间"
                    ]
                }
            ]
        },
        "选完植物时滑动到最顶上的时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "滑回最顶上": {
                    "duration": "{滑动时间}"
                }
            }
        },
        "选卡时滑动的持续时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "200",
                    "verify": "[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "寻找植物_滑动": {
                    "duration": "{滑动时间}"
                }
            }
        },
        "选卡滑动后的按住屏幕时间": {
            "description": "单位为毫秒",
            "type": "input",
            "inputs": [
                {
                    "name": "滑动时间",
                    "pipeline_type": "int",
                    "default": "50",
                    "verify": "[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "寻找植物_滑动": {
                    "end_hold": "{滑动时间}"
                }
            }
        }
    },
    "global_option": [
        "渠道服"
